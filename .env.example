# ─────────────────────────────────────────────────────────────
# フロントエンド（ビルド時に埋め込まれる。GitHub Actions の Secrets に設定）
# ─────────────────────────────────────────────────────────────
# Supabase プロジェクトの URL と anon key。
# 未設定の場合アプリは「デモモード」で動作し、AI はテンプレート生成・
# データはブラウザの localStorage にのみ保存される（共有は同一ブラウザ内のみ）。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# GitHub Pages のプロジェクトページ用サブパス（例: /tabi-no-shiori）。
# ユーザーページ（<user>.github.io）や独自ドメインなら空のままでよい。
NEXT_PUBLIC_BASE_PATH=

# ─────────────────────────────────────────────────────────────
# Supabase Edge Functions のシークレット（`supabase secrets set` で設定）
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
#   supabase secrets set ANTHROPIC_MODEL=claude-sonnet-5
# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY はデプロイ済み関数に自動注入される。
# ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
